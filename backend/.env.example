# ===========================
# FinTrackAI — Backend .env
# ===========================

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/fintrackAI
# OR Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fintrackAI

# JWT Secret (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# JWT Expiry
JWT_EXPIRES_IN=7d

# Server Port
PORT=5000

# Groq API Key (for AI Insights feature) — get a free key at console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) Override the Groq model — defaults to llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
